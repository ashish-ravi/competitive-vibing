# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard → project settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron auth for /api/cron/keepalive (keeps a free-tier Supabase project
# from pausing). Generate with: openssl rand -hex 32. Set in Vercel too.
CRON_SECRET=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional model override. Must support json_schema structured outputs.
# Default: meta-llama/llama-4-scout-17b-16e-instruct (30k TPM on the free tier).
# GROQ_MODEL=
# Optional override for counterexample generation (a reasoning-heavy task).
# Default: openai/gpt-oss-120b, falling back to GROQ_MODEL if unavailable.
# GROQ_COUNTEREXAMPLE_MODEL=
# Optional override for counterexample verification (independent checker with
# its own per-model TPM budget). Default: openai/gpt-oss-20b.
# GROQ_VERIFY_MODEL=
